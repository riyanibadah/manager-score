DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rate_my_manager?sslmode=require"
REVIEW_HASH_SALT="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
ADMIN_EMAILS="you@example.com,cofounder@example.com"

# Used to email sharkawykyrillos@gmail.com when someone reports a review or
# posts a reply, and to send reply alerts to people who subscribed to a review.
# Sign up at https://resend.com, create an API key, and (optionally) verify
# a sending domain to set REPORT_NOTIFICATION_FROM.
# NEXT_PUBLIC_SITE_URL must be set in production so confirm/unsubscribe links
# in those emails point at the live site rather than localhost.
RESEND_API_KEY="replace-with-resend-api-key"
REPORT_NOTIFICATION_FROM="ManagerScore <onboarding@resend.dev>"
# Must match the live origin exactly, including the www host — it is what
# canonical urls, sitemap entries, and email links are built from. Pointing it
# at the wrong hostname makes every canonical reference a domain that isn't the
# site, which is worse than leaving it unset.
NEXT_PUBLIC_SITE_URL="https://www.managerscore.io"
